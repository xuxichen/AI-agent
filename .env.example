# Copy to .env and fill in real values. .env is gitignored; this file is not.
# 复制到 .env 后填入真实值。.env 已被 gitignore，本文件会被提交。
#
# 教程（尚硅谷 LangGraph）默认使用 DeepSeek，只填这一项就能跟完全程。
# Get one: https://platform.deepseek.com/api_keys  （key 只显示一次，立即保存）

DEEPSEEK_API_KEY=

# --- Optional: only needed if a chapter switches provider -------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional: tracing / deployment (course chapter 04) ---------------------
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=langgraph-tutorial
